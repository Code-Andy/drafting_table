<?xml version="1.0" encoding="utf-8"?>
<!-- Layer panel section header strip — same paper tone as the body, with
     a hairline rule along the bottom to separate sections. Implemented
     as a layer-list with a background fill + a 1dp bottom rule. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/paper" />
        </shape>
    </item>
    <item android:gravity="bottom" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rule" />
        </shape>
    </item>
</layer-list>
