<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <group android:pivotX="12" android:pivotY="12" android:scaleX="1.3" android:scaleY="1.3">
        <!-- + matches ic_plus.xml exactly so the two icons line up
             vertically and have the same stroke length. -->
        <path android:strokeColor="#000" android:strokeWidth="1.5"
              android:strokeLineCap="round" android:fillColor="#00000000"
              android:pathData="M12,5 L12,19 M5,12 L19,12"/>
        <!-- subscript v inside the +'s bottom-right quadrant. Bottom
             point sits at y=19 so it lines up with the +'s bottom edge. -->
        <path android:strokeColor="#000" android:strokeWidth="1.2"
              android:strokeLineCap="round" android:strokeLineJoin="round"
              android:fillColor="#00000000"
              android:pathData="M15.5,15 L17,19 L18.5,15"/>
    </group>
</vector>
