<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <!-- bezier curve through 3 anchors -->
    <path android:strokeColor="#000" android:strokeWidth="1.5"
          android:strokeLineCap="round" android:fillColor="#00000000"
          android:pathData="M5,18 C8,8 16,8 19,18"/>
    <!-- start + end anchors (stroke-only squares so paper shows through) -->
    <path android:strokeColor="#000" android:strokeWidth="1.2"
          android:strokeLineJoin="round" android:fillColor="#00000000"
          android:pathData="M3.5,16.5 h3 v3 h-3 z M17.5,16.5 h3 v3 h-3 z"/>
    <!-- apex anchor (filled) -->
    <path android:fillColor="#000"
          android:pathData="M10.5,8.5 h3 v3 h-3 z"/>
    <!-- bezier handle lines (rendered as 4 short segments to fake dashes) -->
    <path android:strokeColor="#000" android:strokeWidth="1"
          android:strokeLineCap="round" android:fillColor="#00000000"
          android:pathData="M6,10 l1.5,0 M9,10 l1.5,0 M13.5,10 l1.5,0 M16.5,10 l1.5,0"/>
    <!-- handle endpoints -->
    <path android:fillColor="#000"
          android:pathData="M5,10 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 Z
                            M19,10 m-1,0 a1,1 0 1,0 2,0 a1,1 0 1,0 -2,0 Z"/>
</vector>
