<?xml version="1.0" encoding="utf-8"?>
<!-- Floating chrome chip (undo/redo, page nav). PaperDeep fill + 1dp
     rule outline so it sits cleanly over the canvas without competing
     with the drawing. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/paperDeep" />
    <stroke android:width="1dp" android:color="@color/rule" />
    <corners android:radius="2dp" />
</shape>
