<!--
    Concept 01 — T-square + triangle, on a faint grid.
    Mirrors the IconConcept1 design from the icon contact sheet:
      - Faint grid (13×13 lines, ~6% ink) anchored to the squircle.
      - T-square head (left) + horizontal blade.
      - Tick marks on the blade, longest every 4th.
      - 45° set-square with paper-colored hypotenuse highlight + inner
        cutout (paper-colored polygon over the triangle, reads as a hole).
    Background paper fill lives in the launcher's background layer.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="1024" android:viewportHeight="1024">

    <!-- Faint grid: 13 vertical + 13 horizontal lines at 80 + i*72 -->
    <path android:strokeColor="#0F1F1B14" android:strokeWidth="1"
          android:fillColor="#00000000"
          android:pathData="M80,0 L80,1024 M152,0 L152,1024 M224,0 L224,1024
                            M296,0 L296,1024 M368,0 L368,1024 M440,0 L440,1024
                            M512,0 L512,1024 M584,0 L584,1024 M656,0 L656,1024
                            M728,0 L728,1024 M800,0 L800,1024 M872,0 L872,1024
                            M944,0 L944,1024
                            M0,80 L1024,80   M0,152 L1024,152 M0,224 L1024,224
                            M0,296 L1024,296 M0,368 L1024,368 M0,440 L1024,440
                            M0,512 L1024,512 M0,584 L1024,584 M0,656 L1024,656
                            M0,728 L1024,728 M0,800 L1024,800 M0,872 L1024,872
                            M0,944 L1024,944"/>

    <!-- T-square head (left) -->
    <path android:fillColor="#3A3328"
          android:pathData="M120,660 L200,660 L200,880 L120,880 Z"/>

    <!-- T-square blade (horizontal) -->
    <path android:fillColor="#3A3328"
          android:pathData="M200,700 L980,700 L980,750 L200,750 Z"/>

    <!-- Tick marks on the blade, paper-colored stroke. Longest every 4th. -->
    <path android:strokeColor="#F5EFE0" android:strokeWidth="3"
          android:strokeLineCap="round" android:fillColor="#00000000"
          android:pathData="M240,700 L240,672 M300,700 L300,684
                            M360,700 L360,684 M420,700 L420,684
                            M480,700 L480,672 M540,700 L540,684
                            M600,700 L600,684 M660,700 L660,684
                            M720,700 L720,672 M780,700 L780,684
                            M840,700 L840,684 M900,700 L900,684"/>

    <!-- 45° set-square (right triangle). 92% opacity for a subtle paper feel. -->
    <path android:fillColor="#B5482E" android:fillAlpha="0.92"
          android:pathData="M320,700 L320,300 L720,700 Z"/>

    <!-- Hypotenuse highlight along the diagonal -->
    <path android:strokeColor="#F5EFE0" android:strokeWidth="6"
          android:strokeLineCap="round" android:fillColor="#00000000"
          android:pathData="M320,300 L720,700"/>

    <!-- Inner cutout: paper-colored polygon over the triangle so it reads
         as a small hollowed-out interior. -->
    <path android:fillColor="#F5EFE0"
          android:pathData="M380,640 L380,440 L580,640 Z"/>
</vector>
